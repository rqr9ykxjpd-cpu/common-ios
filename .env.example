# iOS istemcisine derlenen değerler. service_role, Apple .p8 ve webhook
# secret'ları buraya yazılmaz — onlar yalnızca Supabase Edge Function
# secret'larında durur.
#
# Kurulum: cp .env.example .env  ve değerleri doldur, sonra:
#   ./Scripts/sync-env.sh

SUPABASE_HOST=
SUPABASE_PUBLISHABLE_KEY=

# iOS OAuth client ID (Google Cloud Console). Info.plist'teki GIDClientID buradan dolar.
GOOGLE_CLIENT_ID=
# Web application OAuth client ID — Supabase Auth > Google provider Client ID ile aynı.
GOOGLE_SERVER_CLIENT_ID=
# Boş bırakılırsa GOOGLE_CLIENT_ID'den üretilir (`com.googleusercontent.apps.…`).
GOOGLE_REVERSED_CLIENT_ID=

# RevenueCat iOS public SDK key (`appl_…`). Boşsa StoreKit tek başına çalışır.
REVENUECAT_API_KEY=
