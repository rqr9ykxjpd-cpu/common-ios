{
  "sourceLanguage": "en",
  "strings": {
    "send": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'd like to connect"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı kur"
          }
        }
      }
    },
    "hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a request. Chat when they accept."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğini gönder. Kabul edince sohbet edin."
          }
        }
      }
    },
    "openChat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open chat"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbeti aç"
          }
        }
      }
    },
    "requests": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection requests"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı istekleri"
          }
