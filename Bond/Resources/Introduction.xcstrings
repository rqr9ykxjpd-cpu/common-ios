      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wants to connect with you"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seninle bağlantı kurmak istiyor"
          }
        }
      }
    },
    "accepted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection accepted. You can now chat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı isteği kabul edildi. Artık mesajlaşabilirsiniz."
          }
        }
      }
    },
    "swipeHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe right to connect · Swipe left to close"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağa kaydır: bağlan · Sola kaydır: kapat"
