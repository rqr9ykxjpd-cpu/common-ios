{
  "sourceLanguage": "en",
  "strings": {
    "galleryHint": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafları sağa veya sola kaydır. Büyütmek için dokun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe photos left or right. Tap to expand."
          }
        }
      }
    },
    "galleryEmpty": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz profil fotoğrafı eklenmemiş."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No profile gallery photos yet."
          }
        }
      }
    },
    "galleryOwnEmpty": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiline birkaç fotoğraf ekle. Bunlar akışta gönderi olarak paylaşılmaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add photos to your profile. These won't be published to the feed."
          }
        }
      }
    },
    "previewLabel": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasarım testi · Gerçek istek gönderilmez"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Design preview · No real requests are sent"
          }
        }
      }
    },
    "releaseHint": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Test isteği için bırak. İptal etmek için geri çek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release to try the request. Drag back to cancel."
          }
        }
      }
    },
    "sending": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Test isteği gönderiliyor…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending test request…"
          }
        }
      }
    },
    "sent": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Test isteği gönderildi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test request sent"
          }
        }
      }
    },
    "failed": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Test bağlantısı kesildi. Yeniden deneyebilirsin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test connection failed. You can retry."
          }
        }
      }
    },
    "restart": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Testi sıfırla"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset preview"
          }
        }
      }
    },
    "galleryTitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos"
          }
        }
      }
    }
  },
  "version": "1.0"
}
