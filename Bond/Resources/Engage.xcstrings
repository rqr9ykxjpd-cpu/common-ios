{
  "sourceLanguage": "en",
  "strings": {
    "pushAskTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Know when they reply"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cevap gelince haberin olsun"
          }
        }
      }
    },
    "pushAskMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll let you know when someone writes back or accepts your request."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biri sana yazınca ya da isteğin kabul edilince haber verelim."
          }
        }
      }
    },
    "pushAskConnection": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll let you know when they connect back or write to you."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karşılık gelince ya da sana yazınca haber verelim."
          }
        }
      }
    },
    "pushAskPost": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll let you know when someone answers or votes on your post."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderine cevap ya da oy gelince haber verelim."
          }
        }
      }
    },
    "pushAskGroup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll let you know when someone joins and when your group starts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grubuna biri katılınca ve grup başlarken haber verelim."
          }
        }
      }
    },
    "pushAskAllow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on notifications"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimleri aç"
          }
        }
      }
    },
    "pushAskLater": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi değil"
          }
        }
      }
    },
    "pushOffTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler kapalı"
          }
        }
      }
    },
    "pushOffBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You won't know when someone writes to you."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biri sana yazınca haberin olmuyor."
          }
        }
      }
    },
    "pushOffAction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aç"
          }
        }
      }
    },
    "pushOffDismiss": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizle"
          }
        }
      }
    },
    "chatsInviteTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your friends to campus"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkadaşlarını kampüse getir"
          }
        }
      }
    }
  },
  "version": "1.0"
}
