    "previewMine": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll be at the library this afternoon."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğleden sonra kütüphanedeyim."
