    "themeChangedMine": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You changed the theme to %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet temasını %@ yaptın."
          }
        }
      }
    },
    "themeChangedTheirs": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ changed the theme to %2$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sohbet temasını %2$@ yaptı."
          }
        }
      }
    },
    "reactionChangedMine": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You set the quick reaction to %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı tepkiyi %@ yaptın."
          }
        }
      }
    },
    "reactionChangedTheirs": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ set the quick reaction to %2$@."
