    },
    "quickReaction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick reaction"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı tepki"
          }
        }
      }
    },
    "quickReactionHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap a message to send it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir mesaja çift dokununca bu tepki gider."
          }
        }
      }
    },
    "textSize": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text size"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazı boyutu"
          }
        }
      }
    },
    "textSizeHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only for you, in all chats."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız sende, bütün sohbetlerde."
          }
        }
      }
    },
    "sharedHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You both see the theme and the quick reaction."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema ve hızlı tepki ikinizde de görünür."
          }
        }
      }
    },
