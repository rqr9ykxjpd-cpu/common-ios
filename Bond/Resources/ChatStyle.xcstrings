        }
      }
    },
    "changeFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't change it. Try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değiştirilemedi. Tekrar dene."
          }
        }
