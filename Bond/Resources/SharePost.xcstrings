    },
    "emptyBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect with someone first, then you can send them posts in chat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce biriyle bağlantı kur; sonra gönderileri ona sohbetten yollayabilirsin."
