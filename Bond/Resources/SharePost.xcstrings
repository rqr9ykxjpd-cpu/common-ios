        }
      }
    },
    "noResults": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No one matches that name."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu isimde bağlantın yok."
          }
        }
      }
    },
    "footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The post arrives as a chat message. Tapping it opens the post."
