{
  "sourceLanguage": "en",
  "strings": {
    "fieldTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who invited you?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seni kim davet etti?"
          }
        }
      }
    },
    "fieldPlaceholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "username"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "kullanıcı adı"
          }
        }
      }
    },
    "fieldHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Your friend gets 1 week of Plus once you verify your student email."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı. Öğrenci e-postanı doğrulayınca arkadaşın 1 hafta Plus kazanır."
          }
        }
      }
    },
    "found": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account found"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap bulundu"
          }
        }
      }
    },
    "notFound": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account with this username"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kullanıcı adında bir hesap yok"
          }
        }
      }
    },
    "notSaved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ wasn't found, so no inviter was saved."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "@%@ bulunamadı, davet eden kaydedilmedi."
          }
        }
      }
    },
    "rowTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite friends"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkadaşını davet et"
          }
        }
      }
    },
    "rowHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 week of Plus for each friend who verifies"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulayan her arkadaşın için 1 hafta Plus"
          }
        }
      }
    },
    "headline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your friends to campus"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkadaşlarını kampüse getir"
          }
        }
      }
    },
    "body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask them to enter your username under “Who invited you?” when they sign up. Each time one of them verifies their student email, you get 1 week of Plus."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt olurken “Seni kim davet etti?” alanına kullanıcı adını yazsınlar. Her biri öğrenci e-postasını doğruladığında sana 1 hafta Plus tanımlanır."
          }
        }
      }
    },
    "proNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're already on Pro, so invites don't add Plus time. They still count."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten Pro'dasın; davetler Plus süresi eklemez ama yine sayılır."
          }
        }
      }
    },
    "yourUsername": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your username"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcı adın"
          }
        }
      }
    },
    "copy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyala"
          }
        }
      }
    },
    "copied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyalandı"
          }
        }
      }
    },
    "joined": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joined"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katılan"
          }
        }
      }
    },
    "verified": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulayan"
          }
        }
      }
    },
    "share": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send invite"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davet gönder"
          }
        }
      }
    },
    "shareMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join me on Common! When you sign up, enter @%1$@ under “Who invited you?”. %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Common'a katıl! Kayıt olurken “Seni kim davet etti?” kısmına @%1$@ yaz. %2$@"
          }
        }
      }
    }
  },
  "version": "1.0"
}
