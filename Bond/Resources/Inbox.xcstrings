{
  "sourceLanguage": "en",
  "strings": {
    "deleteAll": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tümünü sil"
          }
        }
      }
    },
    "deleteAllConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all notifications?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün bildirimler silinsin mi?"
          }
        }
      }
    },
    "deleteAllBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can't be undone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu geri alınamaz."
          }
        }
      }
    },
    "deleteFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't delete the notification. Try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim silinemedi. Tekrar dene."
          }
        }
      }
    },
    "chatDeleted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat deleted"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet silindi"
          }
        }
      }
    },
    "clearChat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear chat"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbeti temizle"
          }
        }
      }
    },
    "clearChatConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear your chat with %@?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ile sohbet temizlensin mi?"
          }
        }
      }
    },
    "clearChatBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages are removed only for you; your connection stays and they keep their own history."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajlar yalnızca senden silinir; bağlantın sürer ve karşı taraf kendi geçmişini görmeye devam eder."
          }
        }
      }
    },
    "clearFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't clear the chat. Try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet temizlenemedi. Tekrar dene."
          }
        }
      }
    },
    "chatCleared": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat cleared"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet temizlendi"
          }
        }
      }
    },
    "removeAndDelete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove connection and delete chat"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıyı kaldır ve sohbeti sil"
          }
        }
      }
    },
    "removeAndDeleteConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove your connection with %@ and delete the chat?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ile bağlantın kaldırılsın ve sohbet silinsin mi?"
          }
        }
      }
    },
    "removeAndDeleteBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chat disappears for both of you. If you reconnect later, the old messages won't come back for you."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet ikinizin listesinden de kalkar. İleride yeniden bağlansanız da eski mesajlar sende geri gelmez."
          }
        }
      }
    }
  },
  "version": "1.0"
}
