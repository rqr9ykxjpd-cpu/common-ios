    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We need camera access so you can take photos for posts and stories."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderi ve story paylaşırken fotoğraf çekebilmen için kameraya erişmemiz gerekiyor."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We need photo library access so you can choose a profile photo and posts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil fotoğrafını ve paylaşımlarını seçebilmen için galerine erişmemiz gerekiyor."
          }
        }
      }
    },
